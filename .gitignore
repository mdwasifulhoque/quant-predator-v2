# ============================================
# Quant Predator v2 — project-specific ignores
# ============================================

# Runtime state (regenerated every H1 bar / every run — do not track)
app/state/*.json
app/state/*.csv
app/state/*.log

# Trading/journal logs
logs/
*.log

# W&B experiment tracking (large, regenerated per run)
wandb/

# Model checkpoints (large binaries — track intentionally via Git LFS if needed,
# not by default; uncomment the next line once you've decided on a policy)
# models/**/*.zip

# Environment / secrets
.env

# JetBrains IDE
.idea/

# ============================================
# Standard Python (GitHub template, trimmed to what's relevant)
# ============================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Jupyter Notebook
.ipynb_checkpoints

# mypy / type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
cython_debug/

# Ruff
.ruff_cache/

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Cursor
.cursorignore
.cursorindexingignore

# MkDocs build output (regenerate via `mkdocs build`)
site/

# Import graph SVG renders (regenerable via setup_codebase_kb.sh; keep only the JSON)
docs/*.svg