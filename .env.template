# ==============================================================================
# Quant Predator v2 — Environment Variables Template
# ==============================================================================
# SETUP INSTRUCTIONS:
#   1. Copy this file:   cp .env.template .env
#   2. Fill in your MT5 account credentials below.
#   3. Optionally add a Gemini key if you want to experiment with that API.
#   4. NEVER commit .env to git. It is in .gitignore by default.
# ==============================================================================

# ── MetaTrader 5 Credentials ──────────────────────────────────────────────────
# Find these in MT5: File → Open Account → your account details
MT5_LOGIN=your_account_number_here
MT5_PASSWORD=your_secure_password_here
MT5_SERVER=your_broker_server_name_here
# Example (XM demo): MT5_SERVER=XMGlobal-MT5 3

# ── Optional: Gemini API (not used in v2, kept for reference) ─────────────────
# GEMINI_API_KEY=your_gemini_key_here

# ── Ollama runs locally — no API key needed ───────────────────────────────────
# Ensure Ollama is installed and the model is pulled:
#   ollama pull llama3
